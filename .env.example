# Copie este arquivo para .env.local e preencha. NUNCA commite o .env.local.

# Chave da API do Claude (console.anthropic.com > API Keys). Só o servidor usa.
ANTHROPIC_API_KEY=
# Modelo do Claude. Vazio = claude-opus-5-5. Mais barato: claude-sonnet-5-5 ou claude-haiku-5-5
CLAUDE_MODEL=
# Opcional: esforço de raciocínio (low, medium, high). Vazio = padrão do modelo.
CLAUDE_EFFORT=

# Seu e-mail (ou vários, separados por vírgula). Só eles podem criar conta e usar o chat.
# IMPORTANTE na Vercel: sem isso, qualquer pessoa que achar o site pode usar seus créditos.
EMAILS_PERMITIDOS=

# Sua cidade (opcional). Ajuda a IA a responder sobre o clima e lugares perto de você.
CIDADE=
# Busca na internet: deixe vazio para ligada, ou escreva "desligada" para desligar.
BUSCA_NA_INTERNET=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor, nunca expor. Não é usada na Fase 1 (pode deixar vazia por enquanto).
SUPABASE_SERVICE_ROLE_KEY=
